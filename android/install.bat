@echo off\nREM Script для установки APK на Android устройство через ADB\nREM Использование: install.bat [путь_к_apk]\n\nsetlocal enabledelayedexpansion\n\nset APK_PATH=%1\n\nif \"%APK_PATH%\"==\" \" (\n    set APK_PATH=%~dp0app\\build\\outputs\\apk\\debug\\app-debug.apk\n)\n\necho ================================\necho MUST Inverter Monitor Installer\necho ================================\necho.\n\nREM Проверка наличия ADB\nwhere adb >nul 2>nul\nif %errorlevel% neq 0 (\n    echo Error: ADB not found\n    echo Please install Android Platform Tools\n    echo Download: https://developer.android.com/tools/releases/platform-tools\n    echo.\n    pause\n    exit /b 1\n)\n\nREM Проверка наличия APK файла\nif not exist \"%APK_PATH%\" (\n    echo Error: APK file not found: %APK_PATH%\n    echo.\n    echo Usage: %0 [path_to_apk]\n    echo.\n    echo Example: %0 app\\build\\outputs\\apk\\debug\\app-debug.apk\n    echo.\n    pause\n    exit /b 1\n)\n\necho.\necho APK: %APK_PATH%\necho.\n\nREM Проверка подключенных устройств\necho Checking connected devices...\nadb devices\n\necho.\necho Installing app...\necho.\n\nadb install -r \"%APK_PATH%\"\n\nif %errorlevel% equ 0 (\n    echo.\n    echo ================================\n    echo Installation successful!\n    echo ================================\n    echo.\n    echo Starting app...\n    adb shell am start -n com.mustinverter.monitor/.MainActivity\n    echo.\n    echo App should now be running on your device!\n) else (\n    echo.\n    echo ================================\n    echo Installation failed!\n    echo ================================\n    echo.\n    echo Possible solutions:\n    echo 1. Make sure device is connected via USB\n    echo 2. Enable USB Debugging on device\n    echo 3. Uninstall previous version: adb uninstall com.mustinverter.monitor\n    echo 4. Check that APK file is not corrupted\n)\n\necho.\npause\n"