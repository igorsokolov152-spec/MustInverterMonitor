@echo off\nREM Script для сборки Android приложения на Windows\nREM Использование: build.bat [debug|release]\n\nsetlocal enabledelayedexpansion\n\nset BUILD_TYPE=%1\nif \"%BUILD_TYPE%\"==\" \" set BUILD_TYPE=debug\n\nset PROJECT_DIR=%~dp0\nset GRADLEW=%PROJECT_DIR%gradlew.bat\n\necho ================================\necho MUST Inverter Monitor Builder\necho ================================\necho.\necho Build Type: %BUILD_TYPE%\necho Project Dir: %PROJECT_DIR%\necho.\n\nREM Проверка наличия gradlew.bat\nif not exist \"%GRADLEW%\" (\n    echo Error: gradlew.bat not found\n    echo Please run this script from android directory\n    pause\n    exit /b 1\n)\n\nREM Сборка\necho Building %BUILD_TYPE% APK...\necho.\n\nif /i \"%BUILD_TYPE%\"==\"debug\" (\n    call \"%GRADLEW%\" assembleDebug\n    set APK_PATH=%PROJECT_DIR%app\\build\\outputs\\apk\\debug\\app-debug.apk\n) else if /i \"%BUILD_TYPE%\"==\"release\" (\n    if not exist \"%PROJECT_DIR%keystore.properties\" (\n        echo Error: keystore.properties not found for release build\n        echo Please create keystore first\n        pause\n        exit /b 1\n    )\n    call \"%GRADLEW%\" assembleRelease\n    set APK_PATH=%PROJECT_DIR%app\\build\\outputs\\apk\\release\\app-release.apk\n) else (\n    echo Error: Unknown build type: %BUILD_TYPE%\n    echo Usage: %0 [debug^|release]\n    pause\n    exit /b 1\n)\n\necho.\n\nif exist \"%APK_PATH%\" (\n    echo Build successful!\n    echo.\n    echo APK: %APK_PATH%\n    echo.\n    echo To install on device:\n    echo   adb install -r \"%APK_PATH%\"\n    echo.\n    pause\n) else (\n    echo Error: Build failed - APK not found at %APK_PATH%\n    pause\n    exit /b 1\n)\n"