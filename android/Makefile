.PHONY: help build clean install run test debug release\n\n# Переменные\nGRADLEW := ./gradlew\n\nhelp:\n\t@echo \"MUST Inverter Monitor - Android Build Commands\"\n\t@echo \"\"\n\t@echo \"Available targets:\"\n\t@echo \"  make build         - Build debug APK\"\n\t@echo \"  make clean         - Clean build directory\"\n\t@echo \"  make install       - Build and install on device/emulator\"\n\t@echo \"  make run           - Run app on device/emulator\"\n\t@echo \"  make test          - Run unit tests\"\n\t@echo \"  make ui-test       - Run UI tests on device\"\n\t@echo \"  make release       - Build release APK (requires keystore)\"\n\t@echo \"  make logs          - Show logcat\"\n\t@echo \"  make help          - Show this help message\"\n\nbuild:\n\t$(GRADLEW) build\n\n# Debug APK\ndebug:\n\t$(GRADLEW) assembleDebug\n\t@echo \"Debug APK: app/build/outputs/apk/debug/app-debug.apk\"\n\n# Release APK (требует keystore)\nrelease:\n\t$(GRADLEW) assembleRelease\n\t@echo \"Release APK: app/build/outputs/apk/release/app-release.apk\"\n\nclean:\n\t$(GRADLEW) clean\n\ninstall: debug\n\t$(GRADLEW) installDebug\n\t@echo \"✓ App installed successfully\"\n\nrun: install\n\t@echo \"✓ App running on device/emulator\"\n\ntest:\n\t$(GRADLEW) test\n\nui-test:\n\t$(GRADLEW) connectedAndroidTest\n\nlogs:\n\t@echo \"Fetching logs from device...\"\n\t@adb logcat\n\nlint:\n\t$(GRADLEW) lint\n"